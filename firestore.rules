rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isOwner(){ return signedIn() && request.auth.token.email == "cablueie.123@gmail.com"; }
    function meDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function meActive(){ return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && meDoc().active == true; }
    function myTenant(){ return meActive() ? meDoc().tenantId : ""; }
    function myRole(){ return meActive() ? meDoc().role : ""; }
    function isSuper(){ return isOwner() || myRole() == "super"; }
    function isAdmin(){ return myRole() == "admin"; }

    match /users/{uid} {
      // 自分・運営・同店舗の代表管理者に加え、同じ店舗の有効メンバーも閲覧可(カルテの担当者名照合に必要)。
      allow read: if signedIn() && (request.auth.uid == uid || isSuper()
                    || (meActive() && resource.data.tenantId == myTenant()));
      // オーナー本人は自分のドキュメントを自由に作成/更新可(super昇格のため)
      allow write: if request.auth.uid == uid && isOwner();
      // 一般の自己登録は「メンバー(staff)として既存店舗へ参加」のみ許可(active=false)。
      // 代表管理者(admin)アカウントは運営(営業)がサーバー(Admin SDK)で発行する。クライアントからのadmin自己作成は不可。
      // ★端末枠(deviceLimit)の自己申告を禁止(=有料枠のクライアント側詐称=課金回避を防ぐ)。付与は super/サーバーのみ。
      allow create: if request.auth.uid == uid
                    && request.resource.data.active == false
                    && request.resource.data.role == 'staff'
                    && (!('deviceLimit' in request.resource.data) || request.resource.data.deviceLimit == 2)
                    && (!('edition' in request.resource.data) || request.resource.data.edition in ['works','personal']);
      // 本人は 最終ログイン時刻 / プッシュトークン / 登録端末 のみ更新可(役割・所属などは変更不可)
      // 端末数は deviceLimit(既定2)まで。deviceLimit 自体は本人には変更させない(=有料枠の付与は下の admin/super のみ)。
      allow update: if request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin','fcmTokens','devices'])
                    && request.resource.data.get('devices', []).size() <= resource.data.get('deviceLimit', 2);
      // 承認/無効化: super は全員、admin は自社のみ
      allow delete: if isSuper() || (isAdmin() && resource.data.tenantId == myTenant());
      // 代表管理者(admin)は自社メンバーの「承認/却下/改名/代表管理者への選任・解任」が可能(複数admin可)。
      // ★ただし変更できるキーは active/rejected/name/lastLogin/role に限定し、role の新値は staff|admin のみ許可。
      //   これにより super(運営)への昇格・他店への付け替え(tenantId)・端末枠(deviceLimit)や版(edition)の無料改変を防ぐ。全権変更は super のみ。
      allow update: if isSuper()
                    || (isAdmin() && resource.data.tenantId == myTenant()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','rejected','name','lastLogin','role'])
                        && request.resource.data.role in ['staff','admin']);
    }

    // 契約の申し込み(請求書送付先メール等)。所属者が自社分を作成、運営が閲覧/更新。
    match /signups/{id} {
      allow create: if meActive() && request.resource.data.tenantId == myTenant();
      allow read, update, delete: if isSuper();
    }

    match /tenants/{tid} {
      // ★自社テナント or 運営のみ閲覧可(以前は signedIn() で他店の stripeCustomerId・プラン等が全ユーザーに見えていた)。
      //   参加申請フロー(店舗コード入力)は active=false の自分のusersドキュメント作成で成立し、tenant本体の事前読取は不要。
      allow read: if isSuper() || (meActive() && tid == myTenant());
      // 店舗(事業所)の作成は運営(super)のみ。契約発行はサーバー(Admin SDK)が実行するため一般ユーザーの自由作成は不可。
      allow create: if isSuper();
      allow delete: if isSuper();
      // 更新は運営(super)のみ。有料/無料の切り替え(aiPaidFallback)も運営だけが変更可。
      allow update: if isSuper();
    }

    // 車両DB: 閲覧・作成・更新は有効な同店舗メンバー。ハード削除は代表管理者(admin)/運営(super)のみ。
    //   画面上の「車両削除は管理者のみ」をDB側でも強制する(メンバーがSDK直叩きで削除するのを防ぐ)。
    match /tenants/{tid}/vehicles/{doc} {
      allow read, create, update: if meActive() && (myTenant() == tid || isSuper());
      allow delete: if isSuper() || (isAdmin() && myTenant() == tid);
    }
    // プッシュ通知トークン: 自店舗メンバーが自分の端末トークンを登録/削除できる。
    match /tenants/{tid}/pushTokens/{doc} {
      allow read, write: if isSuper() || (meActive() && myTenant() == tid);
    }
    // その他の社内共有データ(records=整備カルテ/履歴, intakePlans=入出庫予定 等):
    //   閲覧・作成・更新は有効な同店舗メンバー。ハード削除は運営(super)のみ。
    //   ※カルテ・入出庫の「取り消し」は deleted:true のソフト削除(=update)なので、メンバーでも従来どおり可能。
    //   ※read/create/update はメンバーで一切変わらないため、現ログイン中メンバーのアクセス・ログイン状態に影響しない。
    match /tenants/{tid}/{coll}/{doc} {
      allow read, create, update: if meActive() && (myTenant() == tid || isSuper());
      allow delete: if isSuper();
    }

    // AI利用回数の記録(サーバーがAdmin SDKで書き込む)。閲覧は運営 or 自店舗の代表管理者のみ。
    match /usage/{tid} {
      allow read: if isSuper() || (isAdmin() && tid == myTenant());
    }
  }
}
